# ifet-management — environment template  (P0 / Ref 42, LabOS↔Airtable Epic IFET-32)
#
#   cp .env.example .env    then fill in real values.   NEVER commit .env.
#
# `.env` is read automatically by `docker compose` from this directory and is
# gitignored. Every value below that used to be a plaintext literal in
# compose.yaml now lives here instead.
#
# RULE: secrets are SERVER-SIDE ONLY. They must never appear in
#   deployment/config/config.json  or  src/ifet_ui_react/config.json
# — both of those are served to the browser. `deployment/scripts/check-secrets.sh`
# enforces this; run it before every commit and deploy.

# ---------------------------------------------------------------- database ----
POSTGRES_DB=report_db
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Must stay consistent with the three values above. Kept explicit rather than
# composed, so a password containing URL-reserved characters can be percent-
# encoded here without surprising anyone.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@db:5432/report_db

# ------------------------------------------------------------------ pgadmin ---
PGADMIN_DEFAULT_EMAIL=CHANGE_ME
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ------------------------------------------------- SICK gateways (per node) ---
# Not secret, but node-specific: production has these two swapped relative to
# the repo defaults. Set them explicitly per node rather than relying on a
# default.
SICK_API_HOST_1=10.1.10.85
SICK_API_HOST_2=10.1.10.229

# ------------------------------------------------------------------ Airtable --
# Scoped personal access token. Needs data.records:read, data.records:write,
# and schema.bases:read (the last one lets us bind to field IDs instead of
# field names, so an Airtable-side rename cannot break the integration).
#
# Leave blank until the token is issued — the stack starts fine without it and
# AIRTABLE_SYNC_ENABLED stays false, so nothing calls Airtable.
#
# NEVER paste a token into a document, a commit, a chat message, or a config
# file that the UI serves. Out-of-band delivery only (secrets manager).
AIRTABLE_TOKEN=

# Base IDs from the Airtable team's API Integration Guide v2 (2026-08-17),
# recorded in ifet-firmware/docs/labos-airtable-write-contract-v0.3.md §0.1.
#   testing     app4oXS3Kd5IKWgJ7   LabOS Testing Base   <- build against this
#   production  app0OCunbmuXl7Hc9   IFET Airtable Base   <- gated, see below
# (The earlier sandbox appYBTqIL43pmS0xN is RETIRED — do not use it.)
AIRTABLE_BASE_ID=app4oXS3Kd5IKWgJ7

# Table ID, not table name. A rename on the Airtable side would silently defeat
# a name-based allowlist while leaving it looking correct; tbl… IDs survive
# renames. tblnc9SsbXU0C0FWh is "LabOS Raw Data Table".
AIRTABLE_RESULTS_TABLE=tblnc9SsbXU0C0FWh

# Dark-launch switch. Keep false until the write contract is ratified to v1.0
# and the sandbox round-trip is proven.
AIRTABLE_SYNC_ENABLED=false

# The only table LabOS may write. The API client refuses every other table,
# because an Airtable token is scoped per BASE, not per table — this allowlist
# is what actually enforces "read-only everywhere else".
AIRTABLE_WRITE_ALLOWLIST=tblnc9SsbXU0C0FWh

# Second, separate switch for the PRODUCTION base. Guide v2 §5/§7 keep the
# Airtable-side processing automation OFF until they formally enable it after
# acceptance testing, so a correct token plus a correct base ID is deliberately
# NOT sufficient authority to write production. Set this only after the Airtable
# team confirms their automation is on.
AIRTABLE_ALLOW_PRODUCTION_WRITE=false

# Externally reachable origin for report / photo / Excel links written into
# Airtable. Must not be localhost, or every link in Airtable resolves to
# nothing. (Internal-plan gap B.)
LABOS_PUBLIC_ORIGIN=
