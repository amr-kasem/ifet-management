# MQTT Sink Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_BASE_TOPIC=sensors
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_CLIENT_ID=sensor-gateway-client

# REST Source Configuration - Temperature Sensor
REST_SOURCE_temp1_URL=https://api.example.com/sensors/temperature/1
REST_SOURCE_temp1_TYPE=temperature
REST_SOURCE_temp1_HEADER_Authorization=Bearer your_token_here
REST_SOURCE_temp1_UNIT_CONVERSION=C_to_F

# REST Source Configuration - Humidity Sensor
REST_SOURCE_humid1_URL=https://api.example.com/sensors/humidity/1
REST_SOURCE_humid1_TYPE=humidity
REST_SOURCE_humid1_HEADER_Content-Type=application/json

# REST Source Configuration - Weather API (has both temperature and humidity)
REST_SOURCE_weather_URL=https://api.weather.example.com/current
REST_SOURCE_weather_TYPE=temperature
REST_SOURCE_weather_PARAM_lat=37.7749
REST_SOURCE_weather_PARAM_lon=-122.4194
REST_SOURCE_weather_PARAM_units=metric

# Application Settings
POLL_INTERVAL=60  # Time in seconds between polls
LOG_LEVEL=INFO    # DEBUG, INFO, WARNING, ERROR, CRITICAL