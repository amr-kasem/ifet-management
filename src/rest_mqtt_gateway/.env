# MQTT Sink Configuration
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_BASE_TOPIC=sick-sensors
MQTT_CLIENT_ID=sensor-gateway-client

# REST Source Configuration - Temperature Sensor
REST_SOURCE_temp1_URL=https://api.example.com/sensors/temperature/1
REST_SOURCE_temp1_TYPE=proximity

# Application Settings
POLL_INTERVAL=1  # Time in seconds between polls
LOG_LEVEL=INFO    # DEBUG, INFO, WARNING, ERROR, CRITICAL